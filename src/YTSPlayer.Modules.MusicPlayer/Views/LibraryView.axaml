<UserControl xmlns:loc="using:YTSPlayer.Ui.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YTSPlayer.Modules.MusicPlayer.ViewModels"
             xmlns:m="using:YTSPlayer.Modules.MusicPlayer"
             xmlns:ui="using:YTSPlayer.Ui.Controls"
             xmlns:icons="using:YTSPlayer.Ui"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="YTSPlayer.Modules.MusicPlayer.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource Space.S}">

        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource Space.S}">
            <ComboBox ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex}" MinWidth="130" />
            <Button Grid.Column="1" Content="{loc:T music.view.addFolder}" Classes="primary" Click="OnAddFolder" />
            <Button Grid.Column="2" Content="{loc:T music.view.rescan}" Command="{Binding RescanCommand}" IsEnabled="{Binding !IsScanning}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Space.S}">
            <Button Classes="ghost" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}" ToolTip.Tip="{loc:T music.view.up}"><mi:MaterialIcon Kind="ArrowUp" /></Button>
            <TextBlock Grid.Column="1" Text="{Binding PathText}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Click="OnPlaySelection" ToolTip.Tip="{loc:T music.view.playSel.tip}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                    <mi:MaterialIcon Kind="PlaylistPlay" />
                    <TextBlock Text="{loc:T music.view.playSel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <CheckBox Grid.Column="3" Content="{loc:T music.view.preview}" IsChecked="{Binding AutoPreview}" />
        </Grid>

        <ui:LoadingState Grid.Row="2" State="{Binding State}" Message="{Binding Message}"
                         ErrorText="{Binding ErrorText}" RetryCommand="{Binding ReloadCommand}">
            <ListBox Classes="page" x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Multiple"
                     DoubleTapped="OnDoubleTapped" KeyDown="OnListKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource Space.S}">
                            <!-- Cover, wenn vorhanden; sonst das Symbol (Ordner, Titel …) -->
                            <Border Classes="thumb">
                                <Grid>
                                    <mi:MaterialIcon Kind="{Binding Icon, Converter={x:Static icons:IconConverters.Kind}}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     IsVisible="{Binding !HasCover}" />
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Classes="caption muted" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:PlayingBars Grid.Column="2" Playing="{Binding IsPlayingNow}" IsVisible="{Binding IsCurrent}" />
                            <Button Grid.Column="3" Classes="ghost" IsVisible="{Binding IsTrack}" ToolTip.Tip="{loc:T music.view.favorite}"
                                    Command="{Binding ToggleFavoriteCommand}">
                                <mi:MaterialIcon Kind="{Binding FavoriteIcon, Converter={x:Static icons:IconConverters.Kind}}" />
                            </Button>
                            <Button Grid.Column="4" Classes="icon" IsVisible="{Binding IsTrack}" Click="OnRowMenu" ToolTip.Tip="{loc:T music.view.more}">
                                <mi:MaterialIcon Kind="DotsVertical" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ui:LoadingState>

        <StackPanel Grid.Row="3" Spacing="{DynamicResource Space.S}">
            <StackPanel IsVisible="{Binding IsScanning}" Spacing="{DynamicResource Space.XS}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="{Binding ScanText}" Classes="caption muted" />
            </StackPanel>
            <TextBlock Text="{Binding ScanText}" Classes="caption muted" IsVisible="{Binding !IsScanning}" />
            <Grid ColumnDefinitions="Auto,200,Auto,*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource Space.S}">
                <TextBlock Text="{loc:T music.view.playlist}" VerticalAlignment="Center" Classes="muted" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Playlists}" SelectedItem="{Binding TargetPlaylist}" HorizontalAlignment="Stretch" DisplayMemberBinding="{Binding Name}" />
                <Button Grid.Column="2" Content="{loc:T music.view.addTrack}" Click="OnAddToPlaylist" />
                <TextBox Grid.Column="3" Text="{Binding NewPlaylistName}" PlaceholderText="{loc:T music.view.newName}" />
                <Button Grid.Column="4" Content="{loc:T music.view.newPlaylist}" Command="{Binding CreatePlaylistCommand}" />
                <Button Grid.Column="5" Content="{loc:T music.view.removeFrom}" Click="OnRemoveFromPlaylist" IsVisible="{Binding InPlaylist}" />
                <Button Grid.Column="6" Content="{loc:T music.view.deletePlaylist}" Classes="danger" Command="{Binding DeletePlaylistCommand}" IsVisible="{Binding InPlaylist}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
