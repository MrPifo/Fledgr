<UserControl xmlns:loc="using:YTSPlayer.Ui.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YTSPlayer.Modules.MusicPlayer.ViewModels"
             x:Class="YTSPlayer.Modules.MusicPlayer.Views.MusicSettingsView"
             x:DataType="vm:MusicSettingsViewModel">

    <StackPanel Spacing="{DynamicResource Space.M}">
        <StackPanel Spacing="{DynamicResource Space.S}">
            <TextBlock Classes="heading" Text="{loc:T music.settings.display}" />
            <CheckBox Content="{loc:T music.settings.nowPlaying}" IsChecked="{Binding ShowNowPlaying}" />
        </StackPanel>
        <StackPanel Spacing="{DynamicResource Space.S}">
            <TextBlock Classes="heading" Text="{loc:T music.settings.search}" />
            <CheckBox Content="{loc:T music.settings.tags}" IsChecked="{Binding SearchTags}" />
            <TextBlock Classes="caption muted" TextWrapping="Wrap"
                       Text="{loc:T music.settings.tags.hint}" />
            <Button Content="{loc:T music.settings.rescanNow}" HorizontalAlignment="Left" Command="{Binding RescanNowCommand}" />
            <TextBlock Text="{Binding Info}" Classes="caption muted" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
