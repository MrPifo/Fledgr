<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YTSPlayer.Modules.YtConnect.ViewModels"
             xmlns:m="using:YTSPlayer.Modules.YtConnect"
             xmlns:views="using:YTSPlayer.Modules.YtConnect.Views"
             xmlns:ui="using:YTSPlayer.Ui.Controls"
             xmlns:loc="using:YTSPlayer.Ui.Localization"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="YTSPlayer.Modules.YtConnect.Views.YtView"
             x:DataType="vm:YtViewModel">

    <Grid>
        <!-- Nicht angemeldet -->
        <Border Classes="panel" IsVisible="{Binding ShowLoggedOut}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
            <StackPanel Spacing="{DynamicResource Space.M}">
                <TextBlock Classes="title" Text="YouTube Music" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{loc:T yt.login.intro}" />
                <TextBlock Classes="danger" Text="{Binding Notice}" TextWrapping="Wrap" IsVisible="{Binding HasNotice}" />
                <Button Content="{loc:T yt.login.button}" Classes="primary" Command="{Binding SignInCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- Anmeldung läuft: die Google-Seite ist hier eingebettet -->
        <Grid IsVisible="{Binding ShowLogin}" RowDefinitions="Auto,*" RowSpacing="{DynamicResource Space.S}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Space.S}">
                <TextBlock Classes="heading" Text="{loc:T yt.login.title}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{loc:T yt.login.done}" Classes="primary" Command="{Binding FinishLoginCommand}" />
                <Button Grid.Column="2" Content="{loc:T ui.cancel}" Command="{Binding CancelLoginCommand}" />
            </Grid>
            <ContentControl Grid.Row="1" Content="{Binding LoginSurface}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- Prüfen / Abmelden -->
        <ui:LoadingState IsVisible="{Binding ShowBusy}" State="Loading" Message="{Binding BusyText}" />

        <!-- Angemeldet -->
        <Grid IsVisible="{Binding ShowLoggedIn}" RowDefinitions="*,Auto" RowSpacing="{DynamicResource Space.S}">
            <!-- Liste der Playlists -->
            <!-- Künstler-Seite (aus der Suche oder von einer Karte geöffnet) -->
            <views:ArtistView IsVisible="{Binding ArtistVisible}" />

            <Grid IsVisible="{Binding ShowList}">
                <!-- Startseite: Hero, Schnellzugriff, Stimmungen, Bereiche. Beim Scrollen kommen weitere Bereiche nach. -->
                <ScrollViewer Classes="page" x:Name="HomeScroll" IsVisible="{Binding ShowHomePanel}">
                    <StackPanel MaxWidth="{DynamicResource Size.ContentMax}" Spacing="{DynamicResource Space.M}">
                        <views:HomeHeader />
                        <ui:LoadingState State="{Binding HomeState}" Message="{Binding HomeMessage}"
                                         ErrorText="{Binding HomeError}" RetryCommand="{Binding ReloadHomeCommand}">
                            <views:ShelvesView Sections="{Binding HomeSections}" />
                        </ui:LoadingState>
                    </StackPanel>
                </ScrollViewer>

                <!-- Liste der Playlists -->
                <Grid IsVisible="{Binding ShowPlaylists}" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Space.S}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space.S}">
                        <Button Command="{Binding ShowHomeTabCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                                <mi:MaterialIcon Kind="ChevronLeft" />
                                <TextBlock Text="{loc:T yt.home.back}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Classes="caption muted" Text="{loc:T yt.checking}" VerticalAlignment="Center"
                                   IsVisible="{Binding BackgroundBusy}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Space.S}">
                            <Button Click="OnNewPlaylist" ToolTip.Tip="{loc:T yt.playlist.new.tip}">
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                                    <mi:MaterialIcon Kind="PlaylistPlus" />
                                    <TextBlock Text="{loc:T yt.playlist.new}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="{loc:T yt.refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}" />
                            <Button Content="{loc:T yt.open}" Command="{Binding OpenPlaylistCommand}" />
                            <Button Content="{loc:T yt.play}" Classes="primary" Command="{Binding PlaySelectedCommand}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding BackgroundBusy}" />
                    <ui:LoadingState Grid.Row="2" State="{Binding State}" Message="{Binding Message}"
                                     ErrorText="{Binding ErrorText}" RetryCommand="{Binding RefreshCommand}">
                        <ListBox Classes="page roomy" x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DoubleTapped="OnPlaylistDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:PlaylistInfo">
                                    <Border Classes="row plain" Classes.active="{Binding PlayingHere}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Space.M}" ContextRequested="OnPlaylistContext" Background="Transparent">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Classes="row" Classes.highlight="{Binding PlayingHere}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplaySub}" Classes="small secondary" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ui:PlayingBars Grid.Column="1" Playing="{Binding PlayerRunning}" IsVisible="{Binding PlayingHere}" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Classes="icon header" Click="OnPlaylistMenu" DoubleTapped="OnMenuButtonDoubleTapped"
                                                    ToolTip.Tip="{loc:T yt.more}">
                                                <mi:MaterialIcon Kind="DotsVertical" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ui:LoadingState>
                </Grid>
            </Grid>

            <!-- Titel einer geöffneten Playlist -->
            <Grid IsVisible="{Binding IsPlaylistOpen}" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Space.S}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Space.S}">
                    <Button Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                            <mi:MaterialIcon Kind="ChevronLeft" />
                            <TextBlock Text="{loc:T yt.back}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Classes="heading" Text="{Binding Opened.Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- Filter: erst in den Treffern sichtbar -->
                    <ComboBox Grid.Column="2" ItemsSource="{Binding FilterNames}" SelectedIndex="{Binding SearchFilterIndex}" MinWidth="130"
                              IsVisible="{Binding IsSearch}" ToolTip.Tip="{loc:T yt.filter.tip}" />
                    <Button Grid.Column="2" Content="{loc:T yt.refresh}" Command="{Binding RefreshTracksCommand}" IsEnabled="{Binding CanRefreshTracks}" IsVisible="{Binding !IsSearch}" />
                    <Button Grid.Column="3" Content="{loc:T yt.playAll}" Classes="primary" Command="{Binding PlaySelectedCommand}" IsVisible="{Binding !IsSearch}" />
                </Grid>
                <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding BackgroundBusy}" />
                <ui:LoadingState Grid.Row="2" State="{Binding TracksState}" Message="{Binding TracksMessage}"
                                 ErrorText="{Binding TracksError}" RetryCommand="{Binding RefreshTracksCommand}">
                    <ListBox Classes="page" x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" DoubleTapped="OnTrackDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackItem">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource Space.M}" ContextRequested="OnTrackContext" Background="Transparent">
                                    <Border Classes="thumb">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" Classes="caption muted" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ui:PlayingBars Grid.Column="2" Playing="{Binding IsPlayingNow}" IsVisible="{Binding IsCurrent}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" Classes="caption muted" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Classes="icon ghost" Click="OnTrackMenu" DoubleTapped="OnMenuButtonDoubleTapped"
                                            ToolTip.Tip="{loc:T yt.more}">
                                        <mi:MaterialIcon Kind="DotsVertical" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ui:LoadingState>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="{DynamicResource Space.S}">
                <!-- Nachfrage vor dem Löschen einer Playlist -->
                <Border Classes="panel flat" IsVisible="{Binding HasDeleteAsk}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Space.S}">
                        <TextBlock Text="{Binding DeleteAskText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{loc:T yt.delete}" Classes="danger" Command="{Binding ConfirmDeleteCommand}" />
                        <Button Grid.Column="2" Content="{loc:T ui.cancel}" Command="{Binding CancelDeleteCommand}" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Info}" Classes="caption muted" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>