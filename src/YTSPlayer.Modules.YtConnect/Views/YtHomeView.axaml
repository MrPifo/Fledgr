<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YTSPlayer.Modules.YtConnect.ViewModels"
             x:Class="YTSPlayer.Modules.YtConnect.Views.YtHomeView"
             x:DataType="vm:YtHomeViewModel">

    <!-- Kachel-Reihe der YouTube-Startseite für Home. Der Kopf (Titel, Knöpfe) kommt von der Shell. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="{DynamicResource Pad.TileRow}">
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.M}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackItem">
                    <Button Classes="bare" Command="{ReflectionBinding $parent[ItemsControl].DataContext.OpenCommand}" CommandParameter="{Binding}">
                        <StackPanel Classes="tile" Width="{DynamicResource Size.HomeTile}" Spacing="{DynamicResource Space.XS}">
                            <Border Classes="cover" Width="{DynamicResource Size.HomeTile}" Height="{DynamicResource Size.HomeTile}">
                                <Grid>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    <Border Classes="dim" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Title}" Classes="row" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" Classes="small secondary" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
