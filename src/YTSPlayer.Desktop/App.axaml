<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YTSPlayer.Desktop.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://YTSPlayer.Ui/Theme/UiResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Ohne eigene Akzentfarbe nimmt Fluent die Windows-Akzentfarbe. Hier kommt sie aus dem aktiven Theme. Eigene Theme-Varianten erben von „Dark“. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="{DynamicResource Color.Accent}" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://YTSPlayer.Ui/UiTheme.axaml" />
    </Application.Styles>
</Application>
