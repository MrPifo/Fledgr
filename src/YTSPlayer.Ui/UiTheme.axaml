        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia">
    <!-- Wird in App.axaml unter Application.Styles NACH FluentTheme eingebunden. -->
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/Base.axaml" />
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/Text.axaml" />
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/Buttons.axaml" />
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/Inputs.axaml" />
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/Surfaces.axaml" />
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/Feedback.axaml" />
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/Lists.axaml" />
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/ScrollBars.axaml" />
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/Player.axaml" />
    <StyleInclude Source="avares://YTSPlayer.Ui/Components/Icons.axaml" />
