<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:YTSPlayer.Ui.Controls">
    <!--
        Scrollbalken: dünne, runde Schiene mit Korn auf dem Griff. Keine Pfeil-Knöpfe, keine Ausblend-Animation.
        Farben: Griff = Brush.Border, beim Überfahren und Ziehen heller. Breite aus Size.ScrollBar.
    -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value, Mode=TwoWay}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton" Focusable="False">
                                <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton" Focusable="False">
                                <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseButton>
                        <Thumb Name="PART_Thumb" Classes="scroll" />
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.ScrollBar}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Track Name="PART_Track" Orientation="Horizontal"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value, Mode=TwoWay}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageLeftButton" Focusable="False">
                                <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageRightButton" Focusable="False">
                                <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseButton>
                        <Thumb Name="PART_Thumb" Classes="scroll" />
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!--
        Seiten-Scrollbalken (Classes="page" an ScrollViewer und ListBox einer Seite): Die Seiten liegen mit Pad.Content rechts 16 px vom Fensterrand.
        Der Balken liegt sonst am Ende des Inhalts. Hier ragt der ScrollViewer in diesen leeren Streifen (Margin.Page) und der Balken sitzt mittig darin.
    -->
    <!-- Die Seite selbst darf nicht an ihrer Kante abschneiden, sonst fehlt der Balken im Streifen. -->
    <Style Selector="TransitioningContentControl, TransitioningContentControl :is(UserControl)">
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="ListBox.page, c|LoadingState">
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="ScrollViewer.page, ListBox.page /template/ ScrollViewer">
        <Setter Property="Margin" Value="{DynamicResource Margin.Page}" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Page}" />
    </Style>
    <Style Selector="ScrollViewer.page ScrollBar:vertical, ListBox.page /template/ ScrollViewer ScrollBar:vertical">
        <Setter Property="Margin" Value="{DynamicResource Pad.PageScrollBar}" />
    </Style>

    <!-- Griff: schmale Kapsel (Abstand zum Rand), Korn darüber. -->
    <Style Selector="Thumb.scroll">
        <Setter Property="MinWidth" Value="{DynamicResource Size.ScrollThumbMin}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.ScrollThumbMin}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bar" Background="{DynamicResource Brush.ScrollThumb}" CornerRadius="{DynamicResource Radius.Round}"
                        Margin="{DynamicResource Pad.ScrollThumb}" ClipToBounds="True">
                    <Border Background="{DynamicResource Brush.Grain}" Opacity="{DynamicResource Grain.Scroll}" IsHitTestVisible="False" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Thumb.scroll:pointerover /template/ Border#Bar">
        <Setter Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}" />
    </Style>
    <Style Selector="Thumb.scroll:pressed /template/ Border#Bar">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>
</Styles>
