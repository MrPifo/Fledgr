<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:YTSPlayer.Ui">
    <!--
        Verteiler der Themes. Die eigentlichen Farben stehen je Theme in Theme/Themes/*.axaml.
        Ein neues Theme: Datei anlegen, Variante in AppThemes ergänzen, hier einen Eintrag hinzufügen.
        Umschalten zur Laufzeit: Application.RequestedThemeVariant = AppThemes.Get("name").
        Views nutzen immer {DynamicResource …}, nie StaticResource für Farben.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="{x:Static ui:AppThemes.Graphit}">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://YTSPlayer.Ui/Theme/Themes/Graphit.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
