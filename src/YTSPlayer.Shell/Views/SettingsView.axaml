<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YTSPlayer.Shell.ViewModels"
             xmlns:plugins="using:YTSPlayer.Contracts.Plugins"
             x:Class="YTSPlayer.Shell.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Space.M}">
        <TextBlock Classes="title" Text="Einstellungen" />

        <Grid Grid.Row="1" ColumnDefinitions="200,*" ColumnSpacing="{DynamicResource Space.L}">
            <!-- Kategorien: Allgemein, Module und ein Eintrag je Modul -->
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsCategory">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="{DynamicResource Space.L}">

                    <Border Classes="panel" IsVisible="{Binding ShowGeneral}">
                        <StackPanel Spacing="{DynamicResource Space.S}">
                            <TextBlock Classes="heading" Text="Allgemein" />
                            <CheckBox Content="Schließen minimiert in die Taskleiste (statt Tray)" IsChecked="{Binding MinimizeOnClose}" />
                            <Grid ColumnDefinitions="Auto,100" ColumnSpacing="{DynamicResource Space.S}">
                                <TextBlock Text="RAM-Ziel (MB)" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding TargetMb}" />
                            </Grid>
                            <TextBlock Classes="heading" Text="Sleep-Timer" />
                            <CheckBox Content="Wiedergabe pausieren, wenn nichts bedient wird (gilt für lokale Musik und YouTube Music)" IsChecked="{Binding SleepTimerEnabled}" />
                            <Grid ColumnDefinitions="Auto,100,*" ColumnSpacing="{DynamicResource Space.S}">
                                <TextBlock Text="Pause nach (Minuten)" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding SleepTimerMinutes}" IsEnabled="{Binding SleepTimerEnabled}" />
                            </Grid>
                            <TextBlock Classes="caption muted" TextWrapping="Wrap"
                                       Text="Als Bedienung zählen Maus, Tastatur, Medientasten und das Tray-Menü. Eine Minute vorher erscheint ein Hinweis. Schnell aus: Mond-Symbol oben in der Kopfzeile oder im Tray." />
                            <TextBlock Classes="heading" Text="Fehlerprotokoll" />
                            <TextBlock Classes="caption muted" Text="{Binding LogDirectory}" TextWrapping="Wrap" />
                            <Button Content="Logordner öffnen" HorizontalAlignment="Left" Click="OnOpenLogFolder" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" IsVisible="{Binding ShowModules}">
                        <StackPanel Spacing="{DynamicResource Space.S}">
                            <TextBlock Classes="heading" Text="Module" />
                            <TextBlock Classes="caption muted" Text="Ausgeschaltete Module verschwinden aus der Oberfläche und geben ihren Speicher frei." TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Plugins}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{DynamicResource Space.S}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PluginToggle">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanChange}" OnContent="" OffContent="" />
                                            </Grid>
                                            <TextBlock Text="{Binding Error}" Classes="caption danger" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Einstellungen des gewählten Moduls (z. B. YouTube Music) -->
                    <Border Classes="panel" IsVisible="{Binding ShowPlugin}">
                        <StackPanel Spacing="{DynamicResource Space.S}">
                            <TextBlock Classes="heading" Text="{Binding SelectedPluginPage.Title}" />
                            <ContentControl Content="{Binding SelectedPluginPage.ViewModel}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
