<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YTSPlayer.Shell.ViewModels"
             xmlns:plugins="using:YTSPlayer.Contracts.Plugins"
             xmlns:loc="using:YTSPlayer.Ui.Localization"
             x:Class="YTSPlayer.Shell.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Space.M}">
        <TextBlock Classes="title" Text="{loc:T shell.nav.settings}" />

        <Grid Grid.Row="1" ColumnDefinitions="200,*" ColumnSpacing="{DynamicResource Space.L}">
            <!-- Kategorien: Allgemein, Module und ein Eintrag je Modul -->
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsCategory">
                        <TextBlock Text="{Binding Title, Converter={x:Static loc:LocConverters.Key}}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1">
                <StackPanel x:Name="Panels" Spacing="{DynamicResource Space.L}">

                    <Border Classes="panel dots" IsVisible="{Binding ShowGeneral}">
                        <StackPanel Spacing="{DynamicResource Space.S}">
                            <TextBlock Classes="heading" Text="{loc:T shell.settings.general}" />
                            <CheckBox Content="{loc:T shell.settings.minimize}" IsChecked="{Binding MinimizeOnClose}" />
                            <CheckBox Content="{loc:T shell.settings.cubicvolume}" IsChecked="{Binding CubicVolume}" />
                            <CheckBox Content="{loc:T shell.settings.playerdocked}" IsChecked="{Binding PlayerDocked}" />
                            <Grid ColumnDefinitions="Auto,100" ColumnSpacing="{DynamicResource Space.S}">
                                <TextBlock Text="{loc:T shell.settings.ram}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding TargetMb}" />
                            </Grid>
                            <TextBlock Classes="heading" Text="{loc:T shell.settings.sleep}" />
                            <CheckBox Content="{loc:T shell.settings.sleep.enable}" IsChecked="{Binding SleepTimerEnabled}" />
                            <Grid ColumnDefinitions="Auto,100,*" ColumnSpacing="{DynamicResource Space.S}">
                                <TextBlock Text="{loc:T shell.settings.sleep.after}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding SleepTimerMinutes}" IsEnabled="{Binding SleepTimerEnabled}" />
                            </Grid>
                            <TextBlock Classes="caption muted" TextWrapping="Wrap"
                                       Text="{loc:T shell.settings.sleep.hint}" />
                            <TextBlock Classes="heading" Text="{loc:T shell.settings.cache}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space.S}">
                                <TextBlock Text="{loc:T shell.settings.cache.size}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CacheSizeText}" Classes="muted" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="{loc:T shell.settings.cache.clear}" Command="{Binding ClearCacheCommand}" />
                            </Grid>
                            <TextBlock Classes="caption muted" TextWrapping="Wrap" Text="{loc:T shell.settings.cache.hint}" />
                            <TextBlock Classes="heading" Text="{loc:T shell.settings.version}" />
                            <TextBlock Classes="caption muted" Text="{Binding VersionText}" />
                            <TextBlock Classes="heading" Text="{loc:T shell.settings.log}" />
                            <TextBlock Classes="caption muted" Text="{Binding LogDirectory}" TextWrapping="Wrap" />
                            <Button Content="{loc:T shell.settings.log.open}" HorizontalAlignment="Left" Click="OnOpenLogFolder" />
                            <TextBlock Classes="heading" Text="{loc:T shell.settings.dev}" />
                            <TextBlock Classes="caption muted" TextWrapping="Wrap" Text="{loc:T shell.settings.dev.hint}" />
                            <Button Content="{loc:T shell.settings.dev.open}" HorizontalAlignment="Left" Command="{Binding OpenDiagnosticsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel dots" IsVisible="{Binding ShowModules}">
                        <StackPanel Spacing="{DynamicResource Space.S}">
                            <TextBlock Classes="heading" Text="{loc:T shell.settings.modules}" />
                            <TextBlock Classes="caption muted" Text="{loc:T shell.settings.modules.hint}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Plugins}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{DynamicResource Space.S}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PluginToggle">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanChange}" OnContent="" OffContent="" />
                                            </Grid>
                                            <TextBlock Text="{Binding Error}" Classes="caption danger" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Einstellungen des gewählten Moduls (z. B. YouTube Music) -->
                    <Border Classes="panel dots" IsVisible="{Binding ShowPlugin}">
                        <StackPanel Spacing="{DynamicResource Space.S}">
                            <TextBlock Classes="heading" Text="{Binding SelectedPluginPage.Title, Converter={x:Static loc:LocConverters.Key}}" />
                            <ContentControl Content="{Binding SelectedPluginPage.ViewModel}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
