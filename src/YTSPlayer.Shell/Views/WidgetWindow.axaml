<Window xmlns:loc="using:YTSPlayer.Ui.Localization" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YTSPlayer.Shell.ViewModels"
        xmlns:views="using:YTSPlayer.Shell.Views"
        xmlns:ui="using:YTSPlayer.Ui.Controls"
        xmlns:icons="using:YTSPlayer.Ui"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="YTSPlayer.Shell.Views.WidgetWindow"
        x:DataType="vm:ShellViewModel"
        Width="{DynamicResource Size.WidgetWindow}" SizeToContent="Height" CanResize="False" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" TransparencyLevelHint="Transparent" Background="Transparent"
        WindowDecorations="None" Title="Fledgr Widget">

    <Window.Styles>
        <!-- Ohne Cover ist die obere Zeile flach: die Steuerung rückt etwas nach unten. -->
        <Style Selector="StackPanel.transport.fav">
            <Setter Property="Margin" Value="{DynamicResource Pad.WidgetFav}" />
        </Style>
        <Style Selector="Grid.controls.nocover">
            <Setter Property="Margin" Value="{DynamicResource Pad.WidgetNoCover}" />
        </Style>
    </Window.Styles>

    <!-- Mini-Version der Player-Karte (Vorlage widgets-v13): runde Ecken, Korn, Cover, Titel, dann Menü | Transport | Lautstärke, unten der Fortschritt. -->
    <!-- Das ganze Widget ist 5 % größer als die Vorlage (300 px Breite). -->
    <LayoutTransformControl LayoutTransform="scale(1.05)">
    <Border Classes="player widget" Margin="{DynamicResource Pad.WidgetShadow}" PointerPressed="OnDrag" PointerMoved="OnDragMove" PointerReleased="OnDragEnd">
        <Grid>
            <Border Classes="grain g-player" CornerRadius="{DynamicResource Radius.L}" />
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource Space.XS}">

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space.M}">
                    <!-- Links: Cover, darunter die Quelle (Symbol und Kurzname). -->
                    <StackPanel Spacing="{DynamicResource Space.XS}" Width="{DynamicResource Size.CoverWidget}" IsVisible="{Binding ShowCoverColumn}">
                        <Border Classes="cover" Classes.zoom="{Binding CanOpenExternal}" BoxShadow="{DynamicResource Shadow.Cover}" Width="{DynamicResource Size.CoverWidget}" Height="{DynamicResource Size.CoverWidget}"
                                CornerRadius="{DynamicResource Radius.Cover}" IsVisible="{Binding HasCover}">
                            <Grid>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                <Border Classes="scrim" IsVisible="{Binding CanOpenExternal}" PointerPressed="OnCoverPressed"
                                        ToolTip.Tip="{Binding ExternalLabel}">
                                    <mi:MaterialIcon Kind="OpenInNew" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{DynamicResource Space.XS}" IsVisible="{Binding ShowSourceLine}">
                            <ContentControl Classes="tone" Tag="{Binding SourceTone}" VerticalAlignment="Center">
                                <mi:MaterialIcon Kind="{Binding SourceIcon, Converter={x:Static icons:IconConverters.Kind}}"
                                                 Width="{DynamicResource Size.IconSource}" Height="{DynamicResource Size.IconSource}" Classes="shadow-icon" />
                            </ContentControl>
                            <TextBlock Text="{Binding SourceShort}" Classes="micro muted shadow" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <ui:MarqueeText Text="{Binding Title}" Classes="label shadow" />
                        <Border Background="Transparent" Cursor="Hand" IsHitTestVisible="{Binding CanOpenArtist}" PointerPressed="OnArtistPressed"
                                ToolTip.Tip="{loc:T shell.player.artistpage}">
                            <ui:MarqueeText Text="{Binding ArtistLine}" Classes="small secondary shadow" />
                        </Border>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Classes="icon header compact" Command="{Binding ReturnToMainCommand}" ToolTip.Tip="{loc:T shell.widget.back}"><mi:MaterialIcon Kind="ArrowExpand" Classes="shadow-icon" /></Button>
                            <Button Classes="icon header compact" Command="{Binding QuitCommand}" ToolTip.Tip="{loc:T shell.nav.quit}"><mi:MaterialIcon Kind="Close" Classes="shadow-icon" /></Button>
                        </StackPanel>
                        <!-- Signal-Balken (nur Radio): bewegen sich, solange der Stream wirklich läuft. -->
                        <StackPanel Classes="bars" Classes.on="{Binding BarsOn}" HorizontalAlignment="Right" IsVisible="{Binding IsLive}"
                                    Margin="{DynamicResource Pad.Bars}">
                            <Border Classes="bar b1" />
                            <Border Classes="bar b2" />
                            <Border Classes="bar b3" />
                            <Border Classes="bar b4" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Links Favoriten (Radio), rechts Drei-Punkte-Menü und Lautstärke. Alle drei liegen in einer Zelle, damit Play genau mittig im Widget steht. -->
                <Grid Grid.Row="1" Classes="controls" Classes.nocover="{Binding !HasCover}">
                    <Button Classes="bare" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnFavorites" IsVisible="{Binding CanFavorites}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                            <mi:MaterialIcon Kind="Star" Classes="shadow-icon" Foreground="{DynamicResource Brush.Highlight}" />
                            <TextBlock Text="{loc:T shell.widget.favorites}" Classes="small secondary" VerticalAlignment="Center" />
                            <mi:MaterialIcon Kind="ChevronDown" Classes="shadow-icon" Width="{DynamicResource Size.IconS}" Height="{DynamicResource Size.IconS}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Classes="transport" Classes.fav="{Binding CanFavorites}" Orientation="Horizontal" Spacing="{DynamicResource Space.XS}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="translateY(-5px)">
                        <Button Classes="icon step" Command="{Binding PreviousCommand}" IsVisible="{Binding CanPrevious}"><mi:MaterialIcon Kind="SkipPrevious" Classes="shadow-icon" /></Button>
                        <Button Classes="play compact" Command="{Binding TogglePlayCommand}"><mi:MaterialIcon Kind="{Binding PlayIcon, Converter={x:Static icons:IconConverters.Kind}}" Classes="shadow-icon" /></Button>
                        <Button Classes="icon step" Command="{Binding NextCommand}" IsVisible="{Binding CanNext}"><mi:MaterialIcon Kind="SkipNext" Classes="shadow-icon" /></Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="icon compact" Click="OnTrackMenu" IsVisible="{Binding CanWidgetMore}" ToolTip.Tip="{loc:T shell.player.more}">
                        <mi:MaterialIcon Kind="DotsVertical" Classes="shadow-icon" />
                    </Button>
                    <Button x:Name="VolumeButton" Classes="icon compact" Click="OnVolumeClick" PointerPressed="OnVolumePressed" IsVisible="{Binding CanVolume}" ToolTip.Tip="{loc:T shell.player.volume}">
                        <mi:MaterialIcon Kind="{Binding VolumeIcon, Converter={x:Static icons:IconConverters.Kind}}" Classes="shadow-icon" />
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Top" ShowMode="Transient" VerticalOffset="0" FlyoutPresenterClasses="pop volume">
                                <Border Classes="pop-card" Width="{DynamicResource Size.VolumePop}" Height="{DynamicResource Size.VolumePopH}">
                                    <Grid>
                                        <Border Classes="grain g-menu" CornerRadius="{DynamicResource Radius.Card}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space.S}" Margin="{DynamicResource Pad.Pop}" VerticalAlignment="Center">
                                            <Slider Classes="volume compact" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding VolumeText}" Classes="tiny secondary" Width="{DynamicResource Size.VolumeText}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space.S}" IsVisible="{Binding CanSeek}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PositionText}" Classes="tiny secondary" VerticalAlignment="Center" />
                    <views:PlayerSeekBar Grid.Column="1" Classes="progress compact" Minimum="0" Maximum="{Binding SliderMax}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="tiny secondary" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </LayoutTransformControl>
</Window>
