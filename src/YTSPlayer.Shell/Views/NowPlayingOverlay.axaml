<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="YTSPlayer.Shell.Views.NowPlayingOverlay"
        Title="Fledgr Now Playing"
        Background="Transparent" TransparencyLevelHint="Transparent" SystemDecorations="None"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" CanResize="False"
        WindowStartupLocation="Manual">

    <!-- Streifen oben über den ganzen Bildschirm. Er ist durchsichtig, nur das Schild in der Mitte ist sichtbar. -->
    <Border Classes="raised" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.85"
            Margin="{DynamicResource Pad.S}" Padding="{DynamicResource Pad.S}"
            MaxWidth="{DynamicResource Size.NowPlaying}">
        <TextBlock x:Name="Line" Classes="heading" TextTrimming="CharacterEllipsis" />
    </Border>
</Window>
